# 复制一份为 .env 后按需修改：cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，不会被提交

# ---------- 必填 ----------
# 访问本代理服务时使用的密码（客户端把它当作 Bearer Token / api_key）
CODEBUDDY_PASSWORD=change_me_to_your_own_password

# ---------- 认证方式 ----------
# auto  : 有 CODEBUDDY_API_KEY 就用它，否则用 .codebuddy_creds 里的凭证
# api_key: 只使用 CODEBUDDY_API_KEY（推荐，国内版请同时设置 INTERNET_ENVIRONMENT=internal）
# token : 只使用 .codebuddy_creds 目录里的凭证
CODEBUDDY_AUTH_MODE=api_key
CODEBUDDY_API_KEY=

# internal / ioa -> https://copilot.tencent.com（国内）
# public / 留空 -> https://www.codebuddy.ai（国际）
CODEBUDDY_INTERNET_ENVIRONMENT=internal

# ---------- 服务监听 ----------
# 用 Docker 部署时容器内已固定监听 0.0.0.0:8001，这两项对容器无效；
# 只有直接 python web.py 时才需要，本地跑一般保持 127.0.0.1
# CODEBUDDY_HOST=0.0.0.0
# CODEBUDDY_PORT=8001

# ---------- 可选 ----------
# 自定义上游 API 端点，留空则按 CODEBUDDY_INTERNET_ENVIRONMENT 自动选择
# CODEBUDDY_API_ENDPOINT=
# 凭证目录
# CODEBUDDY_CREDS_DIR=.codebuddy_creds
# 日志级别 DEBUG / INFO / WARNING / ERROR
# CODEBUDDY_LOG_LEVEL=INFO
# 每 N 次请求轮换一次凭证
# CODEBUDDY_ROTATION_COUNT=1
# 向客户端报告的模型列表，逗号分隔
# CODEBUDDY_MODELS=claude-4.0,claude-3.7,gpt-5,gpt-5-mini,gpt-5-nano,o4-mini,gemini-2.5-flash,gemini-2.5-pro,auto-chat
# 是否校验 SSL 证书
# CODEBUDDY_SSL_VERIFY=false
